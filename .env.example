# Gemini API Key (for live structured extraction & screenshot verification)
GEMINI_API_KEY=

# Event Store SQLite database path (defaults to ./events.db for persistence)
SCOPESHIFT_DB=./events.db

# Google Cloud Platform settings (optional for live BigQuery / GCS / Vertex dual-write)
SCOPESHIFT_BQ_DATASET=scopeshift_audit
SCOPESHIFT_GCS_BUCKET=scopeshift-artifacts
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Approver allowlist configuration JSON path
SCOPESHIFT_APPROVERS=./approvers.json

# Server host and port
HOST=127.0.0.1
PORT=8765
